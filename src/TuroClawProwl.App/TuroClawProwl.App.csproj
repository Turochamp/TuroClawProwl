<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RootNamespace>TuroClawProwl.App</RootNamespace>
    <AssemblyName>TuroClawProwl</AssemblyName>
    <Version>0.1.0</Version>
    <Company>Creatus</Company>
    <Product>TuroClawProwl</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TuroClawProwl.Application\TuroClawProwl.Application.csproj" />
    <ProjectReference Include="..\TuroClawProwl.Domain\TuroClawProwl.Domain.csproj" />
    <ProjectReference Include="..\TuroClawProwl.Infrastructure\TuroClawProwl.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Destructurama.Attributed" Version="5.3.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
